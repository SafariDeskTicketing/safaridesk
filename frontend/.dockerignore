node_modules
dist
.git
.github
.gitlab-ci.yml
npm-debug.log*
yarn-error.log*

# Exclude every .env* variant, then explicitly allow back the two that are
# tracked, non-secret Vite build config (VITE_* public URLs only) and are
# needed at build time — same "exclude all, allowlist the safe ones"
# pattern as backend/.dockerignore, so a future .env.<anything> mistake is
# excluded by default instead of needing its own ignore rule.
.env*
!.env.production
!.env.development
