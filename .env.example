# SafariDesk self-hosting environment

# App identity
APP_ENV=prod
SAFARIDESK_VERSION=dev
SAFARIDESK_DEPLOYMENT_TYPE=self_hosted
SAFARIDESK_EDITION=community
SAFARIDESK_INSTANCE_ID=

# Published Docker images
DOCKERHUB_NAMESPACE=safaridesk
SAFARIDESK_IMAGE_TAG=latest

# Domains and URLs
DOMAIN_NAME=localhost
APP_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
FRONTEND_URL_BASE=http://localhost
API_BASE_URL=http://localhost
FILE_BASE_URL=http://localhost
MEDIA_URL=/uploads/
MEDIA_ROOT=/mnt/safaridesk
FILE_URL=http://localhost/uploads/files
AVATARS_URL=http://localhost/uploads/avatars
TASK_FILE_URL=http://localhost/uploads/task-files
KB_IMAGE_URL=http://localhost/uploads/kb/images

# Frontend public config, baked into the Vite build
VITE_API_URL=/api/v1
VITE_WS_NOTIFICATIONS_URL=
VITE_CHAT_WS_BASE=
VITE_SITE_URL=/site
VITE_ALLOW_OTP=false

# Security
DEBUG=false
SECRET_KEY=change-me-generate-a-long-random-django-secret
SECRET_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=http://localhost

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=safaridesk
DB_USER=safaridesk
DB_PASSWORD=change-me-db-password
DB_HOST=db
DB_PORT=5432

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email and SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=SafariDesk
INACTIVE_TENANT_ADMIN_EMAIL=admin@example.com

# Admin bootstrap
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=change-me-admin-password
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_FIRST_NAME=Admin
SUPERUSER_LAST_NAME=User
SUPERUSER_PHONE_NUMBER=
CORE_USERNAME=core
CORE_PASSWORD=change-me-core-password
CORE_EMAIL=core@example.com
CORE_FIRST_NAME=Core
CORE_LAST_NAME=User
CORE_PHONE_NUMBER=

# Mail integrations and OAuth
MAIL_INTEGRATION_OAUTH_SUCCESS_URL=http://localhost/settings/mailbox/success
MAIL_INTEGRATION_OAUTH_ERROR_URL=http://localhost/settings/mailbox/error
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/v1/settings/mail/integrations/google/callback/
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost/api/v1/settings/mail/integrations/microsoft/callback/
SAFARIDESK_FORWARDING_DOMAIN=example.com
MAILGUN_SIGNING_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE_URL=https://api.eu.mailgun.net

# Integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
TEAMS_APPLICATION_ID=
TEAMS_DIRECTORY_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SENDER_ID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_TEMPLATE_SID=

# AI providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=1.0
GEMINI_TIMEOUT=30
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_OUTPUT_DIM=1536
AI_DEFAULT_MONTHLY_TOKEN_CAP=1000000
AI_DEFAULT_HARD_CAP_ENABLED=true
AI_DEFAULT_OVERAGE_ENABLED=false
AI_DEFAULT_OVERAGE_PRICE_PER_1K_USD=0.002000

# Billing and licensing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_RETURN_URL=http://localhost/api/v1/payment/return/
SAFARIDESK_LICENSE_KEY=
SAFARIDESK_LICENSE_SERVER_URL=
SAFARIDESK_LICENSE_VIOLATION_DAYS=5

# Optional ports
HTTP_PORT=80
HTTPS_PORT=443

# Docker log container names used by the admin log viewer
LOG_CONTAINER_WEB=safaridesk_backend
LOG_CONTAINER_CELERY=safaridesk_worker
LOG_CONTAINER_CELERY_BEAT=safaridesk_beat
LOG_CONTAINER_CHANNELS=safaridesk_channels
